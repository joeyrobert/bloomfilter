<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>DataTypes</RootNamespace>
    <AssemblyName>DataTypes.BloomFilter</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>BloomFilter.NET</PackageId>
    <Version>2.0.0</Version>
    <Authors>Joseph Robert</Authors>
    <Copyright>Copyright (c) 2009 Joseph Robert</Copyright>
    <Description>A simple, generic Bloom filter: a space-efficient probabilistic set with no false negatives.</Description>
    <PackageTags>bloomfilter;bloom-filter;probabilistic;data-structure</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/joeyrobert/bloomfilter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joeyrobert/bloomfilter</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
